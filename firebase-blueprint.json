{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Optical shop customer order, prescription measurements, payment tracking, and order stage.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique identifier for the customer order."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Firebase Auth UID of the shop owner."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO 8601 creation date string."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer full name."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Customer phone number for WhatsApp and lookup."
        },
        "frame": {
          "type": "string",
          "maxLength": 120,
          "description": "Eyeglass frame model or type."
        },
        "lens": {
          "type": "string",
          "maxLength": 120,
          "description": "Optical lens type or coating."
        },
        "framePrice": {
          "type": "number",
          "description": "Eyeglass frame price in EGP."
        },
        "lensPrice": {
          "type": "number",
          "description": "Optical lenses price in EGP."
        },
        "total": {
          "type": "number",
          "description": "Total order price in EGP."
        },
        "paid": {
          "type": "number",
          "description": "Amount paid so far in EGP."
        },
        "photo": {
          "type": "string",
          "maxLength": 350000,
          "description": "Compressed frame JPEG data URL or empty string."
        },
        "r": {
          "type": "array",
          "description": "Right eye prescription tuple [SPH, CYL, AXIS]."
        },
        "l": {
          "type": "array",
          "description": "Left eye prescription tuple [SPH, CYL, AXIS]."
        },
        "add": {
          "type": "string",
          "maxLength": 16,
          "description": "Optional near addition (ADD) power under the left eye."
        },
        "usageType": {
          "type": "string",
          "enum": ["distance", "reading", ""],
          "description": "Eyeglass usage mode: distance or reading."
        },
        "status": {
          "type": "integer",
          "description": "Current order progress stage from 0 to 4."
        },
        "hist": {
          "type": "array",
          "description": "Timestamps in ms for each reached stage (up to 5 entries)."
        },
        "tok": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unguessable public tracking token."
        },
        "pickupDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Optional scheduled customer pickup date (YYYY-MM-DD)."
        },
        "delivered": {
          "type": "boolean",
          "description": "Whether the customer has already picked up the glasses."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "date",
        "name",
        "phone",
        "frame",
        "lens",
        "total",
        "paid",
        "photo",
        "r",
        "l",
        "status",
        "hist",
        "tok",
        "pickupDate",
        "delivered",
        "createdAt",
        "updatedAt"
      ]
    },
    "TrackOrder": {
