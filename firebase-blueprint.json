          "description": "Firebase Auth UID of the shop owner."
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Reference to parent Customer document ID."
        },
        "shopName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Optical shop display name."
        },
        "n": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer display name without phone or email PII."
        },
        "frame": {
          "type": "string",
          "maxLength": 120,
          "description": "Eyeglass frame model."
        },
        "lens": {
          "type": "string",
          "maxLength": 120,
          "description": "Lens type."
        },
        "total": {
          "type": "number",
          "description": "Total order price in EGP."
        },
        "paid": {
          "type": "number",
          "description": "Amount paid so far in EGP."
        },
        "ph": {
          "type": "string",
          "maxLength": 350000,
          "description": "Compressed frame photo data URL or empty string."
        },
        "r": {
          "type": "array",
          "description": "Right eye prescription [SPH, CYL, AXIS]."
        },
        "l": {
          "type": "array",
          "description": "Left eye prescription [SPH, CYL, AXIS]."
        },
        "add": {
          "type": "string",
          "maxLength": 16,
          "description": "Optional near addition (ADD) power."
        },
        "usageType": {
          "type": "string",
          "enum": ["distance", "reading", ""],
          "description": "Eyeglass usage mode: distance or reading."
        },
        "s": {
          "type": "integer",
          "description": "Order stage from 0 to 4."
        },
        "h": {
          "type": "array",
          "description": "Stage completion timestamps."
        },
        "pickupDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Scheduled customer pickup date (YYYY-MM-DD) or empty string."
        },
        "delivered": {
          "type": "boolean",
          "description": "Whether the glasses have been picked up by the customer."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "tok",
        "ownerId",
        "customerId",
        "shopName",
        "n",
        "frame",
        "lens",
        "total",
        "paid",
        "ph",
        "r",
        "l",
        "s",
        "h",
        "pickupDate",
        "delivered",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Synced per-owner WhatsApp automation and shop preferences across devices.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Firebase Auth UID of the shop owner."
        },
        "shopName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Shop display name."
        },
        "autoWhatsApp": {
          "type": "boolean",
          "description": "Whether to auto-prepare/open WhatsApp when adding customers or advancing order stage."
        },
        "waTemplate": {
          "type": "string",
          "maxLength": 600,
          "description": "Customizable Arabic WhatsApp message template."
        },
        "publicBaseUrl": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional public base URL for generated customer tracking links."
        },
        "websiteUrl": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional connected storefront website URL managed by the Website Control Panel."
        },
        "autoTransferWebOrdersToWhatsApp": {
          "type": "boolean",
          "description": "Whether incoming website orders automatically transfer to the WhatsApp follow-up customer queue."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "shopName",
        "autoWhatsApp",
        "waTemplate",
        "publicBaseUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "PriceItem": {
      "title": "PriceItem",
