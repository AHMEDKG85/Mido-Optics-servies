    "WebProduct": {
      "title": "WebProduct",
      "description": "Storefront catalog product managed in the Website Control Panel across 5 optical categories with colors, pricing, and live availability state.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique identifier for the website catalog product."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Firebase Auth UID of the shop owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Product display name."
        },
        "category": {
          "type": "string",
          "enum": ["medical_glasses", "sunglasses", "lenses", "contact_lenses", "accessories"],
          "description": "Website product category."
        },
        "price": {
          "type": "number",
          "description": "Storefront selling price in EGP."
        },
        "colors": {
          "type": "array",
          "description": "Available color names for this product (up to 15 entries)."
        },
        "available": {
          "type": "boolean",
          "description": "True when available on the website; false when marked out of stock (غير متوفرة حالياً)."
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional storefront product specifications or description."
        },
        "photo": {
          "type": "string",
          "maxLength": 350000,
          "description": "Compressed product JPEG data URL or empty string."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Client creation timestamp in milliseconds."
        },
        "updatedAtMs": {
          "type": "number",
          "description": "Client last update timestamp in milliseconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "category",
        "price",
        "colors",
        "available",
        "notes",
        "photo",
