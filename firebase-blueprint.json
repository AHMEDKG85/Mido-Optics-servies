        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Firebase Auth UID of the shop owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Product or service display name."
        },
        "category": {
          "type": "string",
          "enum": ["frame", "lens", "service"],
          "description": "Item category: frame, lens, or service."
        },
        "price": {
          "type": "number",
          "description": "Unit price in EGP."
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional notes or specifications."
        },
        "photo": {
          "type": "string",
          "maxLength": 350000,
          "description": "Optional compressed frame JPEG data URL or empty string."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Client creation timestamp in milliseconds."
        },
        "updatedAtMs": {
          "type": "number",
          "description": "Client last update timestamp in milliseconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "category",
        "price",
        "notes",
        "createdAtMs",
        "updatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
