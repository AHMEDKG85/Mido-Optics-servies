    "WebOrder": {
      "title": "WebOrder",
      "description": "Customer order received from the connected storefront website with items, prescription measurements, and WhatsApp transfer link.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "orderCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "orderType": { "type": "string", "enum": ["standard", "preorder"] },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerAddress": { "type": "string", "maxLength": 240 },
        "notes": { "type": "string", "maxLength": 400 },
        "items": { "type": "array" },
        "prescription": { "type": ["object", "null"] },
        "frameSubtotal": { "type": "number" },
        "lensSubtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "ready", "delivered", "cancelled"]
        },
        "source": {
          "type": "string",
          "enum": ["storefront_firebase", "webhook", "api", "manual"]
        },
        "convertedCustomerId": { "type": "string", "maxLength": 64 },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "orderCode",
        "invoiceNumber",
        "orderType",
        "customerName",
        "customerPhone",
        "customerAddress",
        "notes",
        "items",
        "prescription",
        "frameSubtotal",
        "lensSubtotal",
        "total",
        "status",
        "source",
        "createdAtMs",
        "updatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Private optical shop customer records and orders, isolated per authenticated shop owner."
    },
    "/track/{trackId}": {
      "schema": {
        "$ref": "#/entities/TrackOrder"
      },
      "description": "Non-PII public tracking view for a specific order token, readable only via direct get by token."
    },
    "/settings/{userId}": {
      "schema": {
        "$ref": "#/entities/ShopSettings"
      },
      "description": "Synced shop preferences and WhatsApp automation settings for the authenticated owner."
    },
    "/prices/{priceId}": {
      "schema": {
        "$ref": "#/entities/PriceItem"
      },
      "description": "Private optical shop product and service price catalog, isolated per authenticated shop owner."
    },
    "/repairs/{repairId}": {
      "schema": {
        "$ref": "#/entities/Repair"
      },
      "description": "Private optical shop repair tickets and welding records, isolated per authenticated shop owner."
    },
    "/repairTrack/{trackId}": {
      "schema": {
        "$ref": "#/entities/RepairTrack"
      },
      "description": "Non-PII public tracking view for a specific repair token, readable only via direct get by token."
    },
    "/webProducts/{productId}": {
      "schema": {
        "$ref": "#/entities/WebProduct"
      },
      "description": "Storefront catalog products managed by the Website Control Panel, isolated per authenticated shop owner."
    },
    "/webOrders/{orderId}": {
      "schema": {
        "$ref": "#/entities/WebOrder"
      },
      "description": "Website customer orders synced from the storefront and linked to WhatsApp follow-up, isolated per authenticated shop owner."
    }
  }
}
