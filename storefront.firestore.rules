rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }
    match /lenses/{lensId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }
    match /settings/storefront_public {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /users/{uid}/loyalty_ledger/{entryId} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create, update, delete: if false;
    }
    match /orders/{orderId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /invoices/{invoiceId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /coupons/{couponId} {
      allow read, write: if isAdmin();
      match /redemptions/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow write: if false;
      }
    }
    match /banners/{bannerId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if false;
    }
    match /deleted_store_orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /deleted_order_codes/{orderCode} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /storefront_audit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /checkout_idempotency/{entryId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
