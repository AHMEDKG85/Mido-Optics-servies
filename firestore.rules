rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidEyeTuple(arr) {
      return arr is list
        && arr.size() == 3
        && arr[0] is string && arr[0].size() <= 16
        && arr[1] is string && arr[1].size() <= 16
        && arr[2] is string && arr[2].size() <= 16;
    }

    function isValidHist(arr) {
      return arr is list
        && arr.size() <= 5
        && (arr.size() == 0 || arr[0] == null || arr[0] is number);
    }

    // --- Validation Blueprints ---
    function isValidCustomer(data, customerId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'date', 'name', 'phone', 'frame', 'lens',
          'total', 'paid', 'photo', 'r', 'l', 'status', 'hist', 'tok',
          'pickupDate', 'delivered', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'date', 'name', 'phone', 'frame', 'lens',
          'total', 'paid', 'photo', 'r', 'l', 'status', 'hist', 'tok',
          'pickupDate', 'delivered', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == customerId && data.id.size() <= 64 && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.date is string && data.date.size() >= 10 && data.date.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 30
        && data.frame is string && data.frame.size() <= 120
        && data.lens is string && data.lens.size() <= 120
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.paid is number && data.paid >= 0 && data.paid <= 10000000
        && data.photo is string && data.photo.size() <= 350000
        && isValidEyeTuple(data.r)
        && isValidEyeTuple(data.l)
        && data.status is int && data.status >= 0 && data.status <= 4
        && isValidHist(data.hist)
        && data.tok is string && data.tok.size() >= 8 && data.tok.size() <= 32 && isValidId(data.tok)
        && data.pickupDate is string && data.pickupDate.size() <= 20
        && (data.pickupDate == '' || data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.delivered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrack(data, trackId) {
      return data.keys().hasAll([
          'tok', 'ownerId', 'customerId', 'shopName', 'n', 'frame', 'lens',
          'total', 'paid', 'ph', 'r', 'l', 's', 'h', 'pickupDate', 'delivered',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tok', 'ownerId', 'customerId', 'shopName', 'n', 'frame', 'lens',
          'total', 'paid', 'ph', 'r', 'l', 's', 'h', 'pickupDate', 'delivered',
          'createdAt', 'updatedAt'
        ])
        && data.tok is string && data.tok == trackId && data.tok.size() >= 8 && data.tok.size() <= 32 && isValidId(data.tok)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.customerId is string && data.customerId.size() <= 64 && isValidId(data.customerId)
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 80
        && data.n is string && data.n.size() >= 1 && data.n.size() <= 120
        && data.frame is string && data.frame.size() <= 120
        && data.lens is string && data.lens.size() <= 120
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.paid is number && data.paid >= 0 && data.paid <= 10000000
        && data.ph is string && data.ph.size() <= 350000
        && isValidEyeTuple(data.r)
        && isValidEyeTuple(data.l)
        && data.s is int && data.s >= 0 && data.s <= 4
        && isValidHist(data.h)
        && data.pickupDate is string && data.pickupDate.size() <= 20
        && (data.pickupDate == '' || data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.delivered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSettings(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'shopName', 'autoWhatsApp', 'waTemplate', 'publicBaseUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'shopName', 'autoWhatsApp', 'waTemplate', 'publicBaseUrl', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 80
        && data.autoWhatsApp is bool
        && data.waTemplate is string && data.waTemplate.size() <= 600
        && data.publicBaseUrl is string && data.publicBaseUrl.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /customers/{customerId} {
      allow get: if isSignedIn() && isVerified() && isValidId(customerId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isVerified()
        && isValidId(customerId)
        && isValidCustomer(incoming(), customerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(customerId)
        && existing().ownerId == request.auth.uid
        && isValidCustomer(incoming(), customerId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().tok == existing().tok
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'frame', 'lens', 'total', 'paid', 'photo', 'r', 'l', 'pickupDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hist', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hist', 'delivered', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'frame', 'lens', 'total', 'paid', 'photo', 'r', 'l', 'pickupDate', 'status', 'hist', 'delivered', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(customerId) && existing().ownerId == request.auth.uid;
    }

    match /track/{trackId} {
      // Public single-document read via secret unguessable token; list is strictly forbidden
      allow get: if isValidId(trackId) && trackId.size() >= 8;
      allow list: if false;

      allow create: if isSignedIn() && isVerified()
        && isValidId(trackId)
        && trackId.size() >= 8
        && isValidTrack(incoming(), trackId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/customers/$(incoming().customerId))
        && getAfter(/databases/$(database)/documents/customers/$(incoming().customerId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && isVerified()
        && isValidId(trackId)
        && trackId.size() >= 8
        && existing().ownerId == request.auth.uid
        && isValidTrack(incoming(), trackId)
        && incoming().ownerId == existing().ownerId
        && incoming().tok == existing().tok
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['s', 'h', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['s', 'h', 'delivered', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'n', 'frame', 'lens', 'total', 'paid', 'ph', 'r', 'l', 'pickupDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'n', 'frame', 'lens', 'total', 'paid', 'ph', 'r', 'l', 'pickupDate', 's', 'h', 'delivered', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(trackId) && existing().ownerId == request.auth.uid;
    }

    match /settings/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn() && isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidSettings(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidSettings(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'autoWhatsApp', 'waTemplate', 'publicBaseUrl', 'updatedAt']);

      allow delete: if false;
    }

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
