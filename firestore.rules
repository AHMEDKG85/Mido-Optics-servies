rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidEyeTuple(arr) {
      return arr is list
        && arr.size() == 3
        && arr[0] is string && arr[0].size() <= 16
        && arr[1] is string && arr[1].size() <= 16
        && arr[2] is string && arr[2].size() <= 16;
    }

    function isValidHist(arr) {
      return arr is list
        && arr.size() <= 5
        && (arr.size() == 0 || arr[0] == null || arr[0] is number);
    }

    function isValidColorList(arr) {
      return arr is list
        && arr.size() <= 15
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 40));
    }

    // --- Validation Blueprints ---
    function isValidCustomer(data, customerId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'date', 'name', 'phone', 'frame', 'lens',
          'total', 'paid', 'photo', 'r', 'l', 'status', 'hist', 'tok',
          'pickupDate', 'delivered', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'date', 'name', 'phone', 'frame', 'lens',
          'framePrice', 'lensPrice', 'total', 'paid', 'photo', 'r', 'l',
          'add', 'usageType', 'status', 'hist', 'tok', 'pickupDate', 'delivered',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == customerId && data.id.size() <= 64 && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.date is string && data.date.size() >= 10 && data.date.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 30
        && data.frame is string && data.frame.size() <= 120
        && data.lens is string && data.lens.size() <= 120
        && (!('framePrice' in data) || (data.framePrice is number && data.framePrice >= 0 && data.framePrice <= 10000000))
        && (!('lensPrice' in data) || (data.lensPrice is number && data.lensPrice >= 0 && data.lensPrice <= 10000000))
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.paid is number && data.paid >= 0 && data.paid <= 10000000
        && data.photo is string && data.photo.size() <= 350000
        && isValidEyeTuple(data.r)
        && isValidEyeTuple(data.l)
        && (!('add' in data) || (data.add is string && data.add.size() <= 16))
        && (!('usageType' in data) || (data.usageType is string && data.usageType in ['distance', 'reading', '']))
        && data.status is int && data.status >= 0 && data.status <= 4
        && isValidHist(data.hist)
        && data.tok is string && data.tok.size() >= 8 && data.tok.size() <= 32 && isValidId(data.tok)
        && data.pickupDate is string && data.pickupDate.size() <= 20
        && (data.pickupDate == '' || data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.delivered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrack(data, trackId) {
      return data.keys().hasAll([
          'tok', 'ownerId', 'customerId', 'shopName', 'n', 'frame', 'lens',
          'total', 'paid', 'ph', 'r', 'l', 's', 'h', 'pickupDate', 'delivered',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tok', 'ownerId', 'customerId', 'shopName', 'n', 'frame', 'lens',
          'total', 'paid', 'ph', 'r', 'l', 'add', 'usageType', 's', 'h',
          'pickupDate', 'delivered', 'createdAt', 'updatedAt'
        ])
        && data.tok is string && data.tok == trackId && data.tok.size() >= 8 && data.tok.size() <= 32 && isValidId(data.tok)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.customerId is string && data.customerId.size() <= 64 && isValidId(data.customerId)
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 80
        && data.n is string && data.n.size() >= 1 && data.n.size() <= 120
        && data.frame is string && data.frame.size() <= 120
        && data.lens is string && data.lens.size() <= 120
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.paid is number && data.paid >= 0 && data.paid <= 10000000
        && data.ph is string && data.ph.size() <= 350000
        && isValidEyeTuple(data.r)
        && isValidEyeTuple(data.l)
        && (!('add' in data) || (data.add is string && data.add.size() <= 16))
        && (!('usageType' in data) || (data.usageType is string && data.usageType in ['distance', 'reading', '']))
        && data.s is int && data.s >= 0 && data.s <= 4
        && isValidHist(data.h)
        && data.pickupDate is string && data.pickupDate.size() <= 20
        && (data.pickupDate == '' || data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.delivered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSettings(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'shopName', 'autoWhatsApp', 'waTemplate', 'publicBaseUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'shopName', 'autoWhatsApp', 'waTemplate', 'publicBaseUrl', 'websiteUrl', 'autoTransferWebOrdersToWhatsApp', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 80
        && data.autoWhatsApp is bool
        && data.waTemplate is string && data.waTemplate.size() <= 600
        && data.publicBaseUrl is string && data.publicBaseUrl.size() <= 200
        && (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 200))
        && (!('autoTransferWebOrdersToWhatsApp' in data) || data.autoTransferWebOrdersToWhatsApp is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPriceItem(data, priceId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'category', 'price', 'notes', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'category', 'price', 'notes', 'photo', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == priceId && data.id.size() <= 64 && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category in ['frame', 'lens', 'service']
        && data.price is number && data.price >= 0 && data.price <= 10000000
        && data.notes is string && data.notes.size() <= 240
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 350000))
        && data.createdAtMs is number && data.createdAtMs >= 0
        && data.updatedAtMs is number && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRepair(data, repairId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'date', 'name', 'phone', 'glassesType', 'weldingType',
          'representativeName', 'cost', 'paid', 'notes', 'status', 'hist', 'tok',
          'pickupDate', 'delivered', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'date', 'name', 'phone', 'glassesType', 'weldingType',
          'representativeName', 'cost', 'paid', 'notes', 'status', 'hist', 'tok',
          'pickupDate', 'delivered', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == repairId && data.id.size() <= 64 && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.date is string && data.date.size() >= 10 && data.date.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 30
        && data.glassesType is string && data.glassesType.size() <= 120
        && data.weldingType is string && data.weldingType.size() <= 120
        && data.representativeName is string && data.representativeName.size() <= 120
        && data.cost is number && data.cost >= 0 && data.cost <= 10000000
        && data.paid is number && data.paid >= 0 && data.paid <= 10000000
        && data.notes is string && data.notes.size() <= 240
        && data.status is int && data.status >= 0 && data.status <= 4
        && isValidHist(data.hist)
        && data.tok is string && data.tok.size() >= 8 && data.tok.size() <= 32 && isValidId(data.tok)
        && data.pickupDate is string && data.pickupDate.size() <= 20
        && (data.pickupDate == '' || data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.delivered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRepairTrack(data, trackId) {
      return data.keys().hasAll([
          'tok', 'ownerId', 'repairId', 'shopName', 'n', 'glassesType', 'weldingType',
          'representativeName', 'cost', 'paid', 's', 'h', 'pickupDate', 'delivered',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tok', 'ownerId', 'repairId', 'shopName', 'n', 'glassesType', 'weldingType',
          'representativeName', 'cost', 'paid', 's', 'h', 'pickupDate', 'delivered',
          'createdAt', 'updatedAt'
        ])
        && data.tok is string && data.tok == trackId && data.tok.size() >= 8 && data.tok.size() <= 32 && isValidId(data.tok)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.repairId is string && data.repairId.size() <= 64 && isValidId(data.repairId)
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 80
        && data.n is string && data.n.size() >= 1 && data.n.size() <= 120
        && data.glassesType is string && data.glassesType.size() <= 120
        && data.weldingType is string && data.weldingType.size() <= 120
        && data.representativeName is string && data.representativeName.size() <= 120
        && data.cost is number && data.cost >= 0 && data.cost <= 10000000
        && data.paid is number && data.paid >= 0 && data.paid <= 10000000
        && data.s is int && data.s >= 0 && data.s <= 4
        && isValidHist(data.h)
        && data.pickupDate is string && data.pickupDate.size() <= 20
        && (data.pickupDate == '' || data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.delivered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'category', 'price', 'colors', 'available',
          'notes', 'photo', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'category', 'price', 'colors', 'available',
          'notes', 'photo', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == productId && data.id.size() <= 64 && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category in ['medical_glasses', 'sunglasses', 'lenses', 'contact_lenses', 'accessories']
        && data.price is number && data.price >= 0 && data.price <= 10000000
        && isValidColorList(data.colors)
        && data.available is bool
        && data.notes is string && data.notes.size() <= 240
        && data.photo is string && data.photo.size() <= 350000
        && data.createdAtMs is number && data.createdAtMs >= 0
        && data.updatedAtMs is number && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'orderCode', 'invoiceNumber', 'orderType',
          'customerName', 'customerPhone', 'customerAddress', 'notes',
          'items', 'prescription', 'frameSubtotal', 'lensSubtotal', 'total',
          'status', 'source', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'orderCode', 'invoiceNumber', 'orderType',
          'customerName', 'customerPhone', 'customerAddress', 'notes',
          'items', 'prescription', 'frameSubtotal', 'lensSubtotal', 'total',
          'status', 'source', 'convertedCustomerId', 'createdAtMs', 'updatedAtMs',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == orderId && data.id.size() <= 64 && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.orderCode is string && data.orderCode.size() >= 1 && data.orderCode.size() <= 64
        && data.invoiceNumber is string && data.invoiceNumber.size() <= 64
        && data.orderType is string && data.orderType in ['standard', 'preorder']
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.customerAddress is string && data.customerAddress.size() <= 240
        && data.notes is string && data.notes.size() <= 400
        && data.items is list && data.items.size() <= 50
        && (data.prescription == null || data.prescription is map)
        && data.frameSubtotal is number && data.frameSubtotal >= 0 && data.frameSubtotal <= 10000000
        && data.lensSubtotal is number && data.lensSubtotal >= 0 && data.lensSubtotal <= 10000000
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.status is string && data.status in ['pending', 'confirmed', 'preparing', 'ready', 'delivered', 'cancelled']
        && data.source is string && data.source in ['storefront_firebase', 'webhook', 'api', 'manual']
        && (!('convertedCustomerId' in data) || (data.convertedCustomerId is string && data.convertedCustomerId.size() <= 64))
        && data.createdAtMs is number && data.createdAtMs >= 0
        && data.updatedAtMs is number && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /customers/{customerId} {
      allow get: if isSignedIn() && isVerified() && isValidId(customerId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isVerified()
        && isValidId(customerId)
        && isValidCustomer(incoming(), customerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(customerId)
        && existing().ownerId == request.auth.uid
        && isValidCustomer(incoming(), customerId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().tok == existing().tok
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'frame', 'lens', 'framePrice', 'lensPrice', 'total', 'paid', 'photo', 'r', 'l', 'add', 'usageType', 'pickupDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hist', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hist', 'delivered', 'paid', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'frame', 'lens', 'framePrice', 'lensPrice', 'total', 'paid', 'photo', 'r', 'l', 'add', 'usageType', 'pickupDate', 'status', 'hist', 'delivered', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(customerId) && existing().ownerId == request.auth.uid;
    }

    match /track/{trackId} {
      // Public single-document read via secret unguessable token; list is strictly forbidden
      allow get: if isValidId(trackId) && trackId.size() >= 8;
      allow list: if false;

      allow create: if isSignedIn() && isVerified()
        && isValidId(trackId)
        && trackId.size() >= 8
        && isValidTrack(incoming(), trackId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/customers/$(incoming().customerId))
        && getAfter(/databases/$(database)/documents/customers/$(incoming().customerId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && isVerified()
        && isValidId(trackId)
        && trackId.size() >= 8
        && existing().ownerId == request.auth.uid
        && isValidTrack(incoming(), trackId)
        && incoming().ownerId == existing().ownerId
        && incoming().tok == existing().tok
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['s', 'h', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['s', 'h', 'delivered', 'paid', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'n', 'frame', 'lens', 'total', 'paid', 'ph', 'r', 'l', 'add', 'usageType', 'pickupDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'n', 'frame', 'lens', 'total', 'paid', 'ph', 'r', 'l', 'add', 'usageType', 'pickupDate', 's', 'h', 'delivered', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(trackId) && existing().ownerId == request.auth.uid;
    }

    match /settings/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn() && isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidSettings(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidSettings(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'autoWhatsApp', 'waTemplate', 'publicBaseUrl', 'websiteUrl', 'autoTransferWebOrdersToWhatsApp', 'updatedAt']);

      allow delete: if false;
    }

    match /prices/{priceId} {
      allow get: if isSignedIn() && isVerified() && isValidId(priceId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isVerified()
        && isValidId(priceId)
        && isValidPriceItem(incoming(), priceId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(priceId)
        && existing().ownerId == request.auth.uid
        && isValidPriceItem(incoming(), priceId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAtMs == existing().createdAtMs
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'notes', 'photo', 'updatedAtMs', 'updatedAt']);

      allow delete: if isSignedIn() && isVerified() && isValidId(priceId) && existing().ownerId == request.auth.uid;
    }

    match /repairs/{repairId} {
      allow get: if isSignedIn() && isVerified() && isValidId(repairId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isVerified()
        && isValidId(repairId)
        && isValidRepair(incoming(), repairId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(repairId)
        && existing().ownerId == request.auth.uid
        && isValidRepair(incoming(), repairId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().tok == existing().tok
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'glassesType', 'weldingType', 'representativeName', 'cost', 'paid', 'notes', 'pickupDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hist', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hist', 'delivered', 'paid', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'glassesType', 'weldingType', 'representativeName', 'cost', 'paid', 'notes', 'pickupDate', 'status', 'hist', 'delivered', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(repairId) && existing().ownerId == request.auth.uid;
    }

    match /repairTrack/{trackId} {
      allow get: if isValidId(trackId) && trackId.size() >= 8;
      allow list: if false;

      allow create: if isSignedIn() && isVerified()
        && isValidId(trackId)
        && trackId.size() >= 8
        && isValidRepairTrack(incoming(), trackId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/repairs/$(incoming().repairId))
        && getAfter(/databases/$(database)/documents/repairs/$(incoming().repairId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && isVerified()
        && isValidId(trackId)
        && trackId.size() >= 8
        && existing().ownerId == request.auth.uid
        && isValidRepairTrack(incoming(), trackId)
        && incoming().ownerId == existing().ownerId
        && incoming().tok == existing().tok
        && incoming().repairId == existing().repairId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['s', 'h', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['s', 'h', 'delivered', 'paid', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'n', 'glassesType', 'weldingType', 'representativeName', 'cost', 'paid', 'pickupDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'n', 'glassesType', 'weldingType', 'representativeName', 'cost', 'paid', 'pickupDate', 's', 'h', 'delivered', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(trackId) && existing().ownerId == request.auth.uid;
    }

    match /webProducts/{productId} {
      allow get: if isSignedIn() && isVerified() && isValidId(productId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isVerified()
        && isValidId(productId)
        && isValidWebProduct(incoming(), productId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(productId)
        && existing().ownerId == request.auth.uid
        && isValidWebProduct(incoming(), productId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAtMs == existing().createdAtMs
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'colors', 'available', 'notes', 'photo', 'updatedAtMs', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['available', 'updatedAtMs', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(productId) && existing().ownerId == request.auth.uid;
    }

    match /webOrders/{orderId} {
      allow get: if isSignedIn() && isVerified() && isValidId(orderId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isVerified()
        && isValidId(orderId)
        && isValidWebOrder(incoming(), orderId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isVerified()
        && isValidId(orderId)
        && existing().ownerId == request.auth.uid
        && isValidWebOrder(incoming(), orderId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAtMs == existing().createdAtMs
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'convertedCustomerId', 'updatedAtMs', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAtMs', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['convertedCustomerId', 'updatedAtMs', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['orderCode', 'invoiceNumber', 'orderType', 'customerName', 'customerPhone', 'customerAddress', 'notes', 'items', 'prescription', 'frameSubtotal', 'lensSubtotal', 'total', 'status', 'source', 'convertedCustomerId', 'updatedAtMs', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(orderId) && existing().ownerId == request.auth.uid;
    }

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
