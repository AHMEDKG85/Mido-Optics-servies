# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MIDO_SYNC_SECRET: Shared with the website's EXTERNAL_SYNC_SECRET to protect API sync,
# order deletion tombstones, and remote website content editing.
MIDO_SYNC_SECRET=""

# Optional comma-separated custom storefront hosts for the authenticated sync proxy.
MIDO_STOREFRONT_ALLOWED_HOSTS=""

# Customer storefront uses the existing separate storefront Firebase project.
# These are public Firebase web-app values, not service-account secrets.
VITE_STOREFRONT_API_KEY=""
VITE_STOREFRONT_AUTH_DOMAIN="gen-lang-client-0748882445.firebaseapp.com"
VITE_STOREFRONT_PROJECT_ID="gen-lang-client-0748882445"
VITE_STOREFRONT_STORAGE_BUCKET="gen-lang-client-0748882445.firebasestorage.app"
VITE_STOREFRONT_MESSAGING_SENDER_ID="1070147434597"
VITE_STOREFRONT_APP_ID="1:1070147434597:web:bfa337219583b627ee6e8c"
VITE_STOREFRONT_DATABASE_ID="ai-studio-midooptics-b2b8b67a-82b2-4742-970e-5fe3b0f6abca"
VITE_FIREBASE_FUNCTIONS_REGION="europe-west1"
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
# Set true only for the local Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS="false"

