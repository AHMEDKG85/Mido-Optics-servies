{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test src/utils/optics.test.ts src/shop/commerce.test.ts",
    "test:rules": "firebase --config firebase.storefront.json emulators:exec --project gen-lang-client-0748882445 --only firestore \"tsx --test tests/firestore.rules.test.ts\"",
    "test:functions:smoke": "firebase --config firebase.storefront.json emulators:exec --project gen-lang-client-0748882445 --only auth,firestore,functions \"node tests/functions-emulator-smoke.cjs\"",
    "test:e2e": "firebase --config firebase.storefront.json emulators:exec --project gen-lang-client-0748882445 --only auth,firestore \"playwright test\""
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite-plugin-pwa": "^2.0.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "firebase-tools": "^15.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
